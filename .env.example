# ===== AI Trip War Room — environment template =====
# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).

# ---- PostgreSQL ----
POSTGRES_DB=warroom
DB_USERNAME=warroom
DB_PASSWORD=change-me-strong-password

# Reactive (runtime) + JDBC (Flyway migrations) URLs — point at the same DB.
R2DBC_URL=r2dbc:postgresql://localhost:5432/warroom
JDBC_URL=jdbc:postgresql://localhost:5432/warroom

# ---- JWT (10.1: short-lived access <= 1h + refresh flow) ----
# Must be >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173

# ---- AI Concierge LLM adapter ----
# provider=template  -> no external key needed; deterministic grounded answers (default)
# provider=openai    -> set LLM_API_KEY, LLM_BASE_URL=https://api.openai.com/v1, LLM_MODEL=gpt-4o-mini
# provider=anthropic -> set LLM_API_KEY, LLM_BASE_URL=https://api.anthropic.com/v1, LLM_MODEL=claude-haiku-4-5-20251001
LLM_PROVIDER=template
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- Misc ----
SERVER_PORT=8080
SEED_ENABLED=true
LOG_LEVEL=INFO

# ---- Frontend (Vite) ----
VITE_API_BASE=http://localhost:8080
VITE_WS_BASE=ws://localhost:8080
